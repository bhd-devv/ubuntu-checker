# Exclude secrets and runtime data from build contexts.
.git
.gitignore

.env
.env.*
*.env
!.env.example
secrets/
*.key
*.pem
*.p12
*.pfx
id_ed25519
id_rsa

beszel-data/
beszel_data/
beszel-agent-data/
beszel_agent_data/
beszel-socket/
beszel_socket/
prometheus-data/
prometheus_data/
telegram-bot-data/
backups/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.sqlite3-shm
*.sqlite3-wal
*.log

__pycache__/
.venv/
.cache/
.DS_Store
._*
