# Set these in Coolify > Environment Variables. Never commit actual secrets.
BESZEL_APP_URL=https://monitor.example.com
BESZEL_USER_EMAIL=admin@example.com
BESZEL_USER_PASSWORD=
# First deploy compose.setup.yml, sign in, and copy the hub's public key.
# This is a PUBLIC ssh-ed25519 key, not a private key or a registration token.
BESZEL_AGENT_KEY=
# GPU: keep these defaults for CPU/battery and automatic AMD sysfs collection.
# NVIDIA requires NVIDIA Container Toolkit configured on the host; see README.
BESZEL_AGENT_IMAGE=henrygd/beszel-agent:0.21.0
BESZEL_AGENT_RUNTIME=runc
BESZEL_GPU_COLLECTOR=

# Required in the full stack; compose.setup.yml does not start the bot yet.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bot reads all systems visible to its Beszel user by default.
# Optional: restrict to one system's ID (from the Beszel API).
TELEGRAM_BESZEL_SYSTEM_ID=
# Optional separate Beszel account. Empty values use BESZEL_USER_EMAIL/PASSWORD.
TELEGRAM_BESZEL_EMAIL=
TELEGRAM_BESZEL_PASSWORD=
TELEGRAM_POLL_INTERVAL_SECONDS=30
TELEGRAM_ALERT_REPEAT_SECONDS=1800

# Host docker0 IPv4, NOT the server's public IP. Verify before deployment:
# ip -4 -o addr show docker0
NODE_EXPORTER_HOST=172.17.0.1

# Prometheus retention is fixed at 30d in docker-compose.yml, with no size cap.
# Beszel 0.21.0 retains 30 days using its built-in rollup tiers.
# Reserve enough disk for the full month, plus WAL/head and Beszel's database.

# Verify: docker info --format '{{.DockerRootDir}}'
DOCKER_DATA_ROOT=/var/lib/docker
DOCKER_ENDPOINT=unix:///var/run/docker.sock
